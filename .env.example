# Obsidian Local REST API (optional — only needed if you want scenario cards
# pushed into an Obsidian vault instead of just output/*.json)
# Find this key in Obsidian -> Settings -> Local REST API with MCP
OBSIDIAN_API_KEY=

# Use http://127.0.0.1:27123 if you enabled the HTTP (insecure) mode in plugin settings
# Use https://127.0.0.1:27124 for the default HTTPS mode
OBSIDIAN_BASE_URL=http://127.0.0.1:27123

# Vault folder where LeetCode scenario cards will be saved
OBSIDIAN_VAULT_FOLDER=LeetCode Scenarios

# Optional: LeetCode session cookie, only needed for private-data MCP tools
LEETCODE_SESSION=
